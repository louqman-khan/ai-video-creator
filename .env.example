# Copy to .env (repo root) and fill in. Never commit .env.

# --- Media sources ---------------------------------------------------------
# Primary source for videos + images (free key: https://pixabay.com/api/docs/)
PIXABAY_API_KEY=
# Optional. Pexels is skipped automatically when this is empty.
PEXELS_API_KEY=
# Openverse and Wikimedia Commons need no key.
# Order = priority when results are interleaved. Sources without a key are skipped.
MEDIA_SOURCES=pixabay,pexels,openverse,wikimedia
# Optional folder of your own clips/images (searched by filename)
LOCAL_MEDIA_DIR=

# --- LLM (scene planner) ----------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.5-flash
# gemini | heuristic (heuristic = no LLM, English only)
SCENE_PLANNER=gemini

# --- Transcription ------------------------------------------------------------
# tiny/base/small/medium/large-v3. Urdu needs medium or larger for decent accuracy.
WHISPER_MODEL=small
