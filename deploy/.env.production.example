# Copy to ../.env.production and fill in. Never commit the real file.
DOMAIN=videos.example.com
PUBLIC_URL=https://videos.example.com
MODE=hosted
SIGNUPS=invite                  # open | invite | closed   (start invite-only)
INVITE_CODES=change-me-1,change-me-2
ADMIN_EMAILS=you@example.com
# e-mail for verification and password reset (any SMTP provider: Brevo, Mailgun, Amazon SES, ...)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AI Video Creator <no-reply@videos.example.com>
# services that do part of the work
GEMINI_API_KEY=
PIXABAY_API_KEY=
# limits per user
MAX_PROJECTS_PER_USER=10
MAX_STORAGE_MB_PER_USER=2000
MAX_EXPORTS_PER_DAY=5
JOB_WORKERS=1
APP_CPUS=4
APP_MEMORY=6g
# the free computer voices are not licensed for a public product: leave them off (default) or add ElevenLabs
# TTS=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_UR=

# Credits: a video costs credits by the length of its narration (1 credit per CREDIT_MINUTES, rounded up, at least 1); the allowance renews on the 1st of each month (UTC).
# Administrators (ADMIN_EMAILS) are not charged. A video that cannot be made gives its credits back.
CREDITS_PER_MONTH=10
CREDIT_MINUTES=1
CREDITS_PLAN_NAME=Free
